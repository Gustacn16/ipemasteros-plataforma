# Endereço do IPEMaster OS (sem barra no fim). Para testar: https://teste.plataformaipemaster.com.br
SISTEMA_URL=https://teste.plataformaipemaster.com.br
# O mesmo valor de MOTOR_WHATSAPP_SEGREDO configurado no sistema. Nunca compartilhe.
MOTOR_WHATSAPP_SEGREDO=
# Pasta onde ficam as sessões dos números (opcional; padrão: a pasta "sessoes" ao lado de src/).
# Caminho relativo conta a partir da pasta do motor, não de onde você roda o comando.
PASTA_SESSOES=
# Nível do log da Baileys (opcional): silent (padrão), warn ou info.
# Use warn/info só para investigar um problema: a Baileys pode imprimir JIDs (telefones).
NIVEL_LOG_BAILEYS=silent

# Endereço do IPEMaster OS (sem barra no fim). Para testar: https://teste.plataformaipemaster.com.br
SISTEMA_URL=https://teste.plataformaipemaster.com.br
# O mesmo valor de MOTOR_WHATSAPP_SEGREDO configurado no sistema. Nunca compartilhe.
MOTOR_WHATSAPP_SEGREDO=
# Pasta onde ficam as sessões dos números (opcional; padrão ./sessoes)
PASTA_SESSOES=./sessoes

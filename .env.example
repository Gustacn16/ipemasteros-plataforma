# Copie para .env e preencha. O .env NUNCA vai para o Git.
# Na Hostinger, cadastre as mesmas variáveis em: Site → Variáveis de ambiente.

# ── Banco (MySQL Hostinger) ─────────────────────────────────────────────────
# Formato: mysql://USUARIO:SENHA@HOST:3306/BANCO
# Caracteres especiais na senha precisam de URL-encode (ex.: @ → %40).
DATABASE_URL="mysql://u000000000_ipm_dev:SENHA@srvXXXX.hstgr.io:3306/u000000000_ipm_dev"
# Só em desenvolvimento: banco vazio usado pelo Prisma para gerar migrations.
SHADOW_DATABASE_URL="mysql://u000000000_ipm_dev:SENHA@srvXXXX.hstgr.io:3306/u000000000_ipm_shadow"

# ── Autenticação (Better Auth) ──────────────────────────────────────────────
# Gere com: openssl rand -base64 32   (um valor diferente por ambiente)
BETTER_AUTH_SECRET=""
# Endereço público do ambiente, sem barra no final.
BETTER_AUTH_URL="http://localhost:3000"

# Token para criar o PRIMEIRO admin em /primeiro-acesso (só funciona com o banco
# sem nenhum usuário). Gere com: openssl rand -hex 24
TOKEN_PRIMEIRO_ACESSO=""

# ── E-mail (SMTP Hostinger) ─────────────────────────────────────────────────
# Sem SMTP configurado, os e-mails são exibidos no log do servidor (só use assim em dev).
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USUARIO=""
SMTP_SENHA=""
SMTP_REMETENTE="IPEMaster OS <nao-responda@plataformaipemaster.com.br>"

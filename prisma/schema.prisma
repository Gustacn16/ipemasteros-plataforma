// Modelo de dados do IPEMaster OS.
// Convenções: docs/03-modelo-de-dados.md. Toda mudança aqui vira migration
// (`npm run db:migrate -- --name <descricao>`). Nunca editar migration aplicada.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─── Core ────────────────────────────────────────────────────────────────────

enum Papel {
  admin
  gestor
  colaborador
  comercial
  professor
  aluno
}

/// Usuário com acesso ao sistema. Desativar (ativo = false) em vez de excluir.
/// Campos `email`, `emailVerificado`, `imagem` e as relações são usados pelo Better Auth.
model Usuario {
  id              String    @id @default(cuid())
  nome            String    @db.VarChar(150)
  email           String    @unique @db.VarChar(191)
  emailVerificado Boolean   @default(false) @map("email_verificado")
  imagem          String?   @db.VarChar(500)
  papel           Papel     @default(colaborador)
  ativo           Boolean   @default(true)
  ultimoAcessoEm  DateTime? @map("ultimo_acesso_em")
  criadoEm        DateTime  @default(now()) @map("criado_em")
  atualizadoEm    DateTime  @updatedAt @map("atualizado_em")

  // Perfil básico, obrigatório no primeiro acesso (nulo só em contas antigas até completarem).
  apelido          String?      @db.VarChar(40)
  whatsapp         String?      @db.VarChar(15)
  cargo            String?      @db.VarChar(80)
  dataNascimento   DateTime?    @map("data_nascimento") @db.Date
  perfilCompletoEm DateTime?    @map("perfil_completo_em")
  foto             FotoUsuario?

  sessoes          Sessao[]
  contas           Conta[]
  convitesEnviados Convite[]      @relation("ConvitesEnviados")
  logsAuditoria    LogAuditoria[]

  membroDeEspacos   MembroEspaco[]
  tarefasCriadas    Tarefa[]            @relation("TarefasCriadas")
  tarefasAtribuidas TarefaResponsavel[]
  historicoTarefas  HistoricoTarefa[]

  conteudosResponsavel Conteudo[]            @relation("ConteudoResponsavel")
  conteudosCriados     Conteudo[]            @relation("ConteudoCriadoPor")
  conteudosAprovados   Conteudo[]            @relation("ConteudoAprovadoPor")
  eventosCriados       EventoInstitucional[] @relation("EventoCriadoPor")
  agendasExternas      AgendaExterna[]
  vendasDoVendedor     Venda[]               @relation("VendasDoVendedor")
  vendasRegistradas    Venda[]               @relation("VendasRegistradas")
  metasDoVendedor      MetaVenda[]           @relation("MetasDoVendedor")
  importacoesAnuncios  ImportacaoAnuncios[]
  assinaturaAgenda     AssinaturaAgenda?

  @@map("usuarios")
}

/// Foto de perfil, já reduzida no navegador (ver ADR 0004). Fica fora de `usuarios` para não pesar as consultas.
model FotoUsuario {
  usuarioId    String   @id @map("usuario_id")
  dados        Bytes    @db.MediumBlob
  tipo         String   @db.VarChar(20)
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("fotos_usuarios")
}

/// Sessão de login (gerenciada pelo Better Auth).
model Sessao {
  id           String   @id
  usuarioId    String   @map("usuario_id")
  token        String   @unique @db.VarChar(191)
  expiresAt    DateTime @map("expira_em")
  ipAddress    String?  @map("ip") @db.VarChar(64)
  userAgent    String?  @map("user_agent") @db.VarChar(500)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("sessoes")
}

/// Credencial de login (senha) ou conta externa (gerenciada pelo Better Auth).
model Conta {
  id                    String    @id @default(cuid())
  usuarioId             String    @map("usuario_id")
  accountId             String    @map("conta_id") @db.VarChar(191)
  providerId            String    @map("provedor_id") @db.VarChar(50)
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expira_em")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expira_em")
  scope                 String?   @db.Text
  password              String?   @map("senha_hash") @db.Text
  criadoEm              DateTime  @default(now()) @map("criado_em")
  atualizadoEm          DateTime  @updatedAt @map("atualizado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("contas")
}

/// Tokens de verificação (ex.: redefinição de senha), gerenciados pelo Better Auth.
model Verificacao {
  id           String   @id
  identifier   String   @map("identificador") @db.VarChar(191)
  value        String   @map("valor") @db.Text
  expiresAt    DateTime @map("expira_em")
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([identifier])
  @@map("verificacoes")
}

/// Convite de acesso. Só o hash do token é guardado; o token vai no link do e-mail.
model Convite {
  id             String    @id @default(cuid())
  email          String    @db.VarChar(191)
  nome           String    @db.VarChar(150)
  papel          Papel
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  expiraEm       DateTime  @map("expira_em")
  aceitoEm       DateTime? @map("aceito_em")
  revogadoEm     DateTime? @map("revogado_em")
  convidadoPorId String    @map("convidado_por_id")
  criadoEm       DateTime  @default(now()) @map("criado_em")

  convidadoPor Usuario @relation("ConvitesEnviados", fields: [convidadoPorId], references: [id])

  @@index([email])
  @@map("convites")
}

/// Registro de auditoria. Somente inserção: nunca editar nem apagar pela aplicação.
model LogAuditoria {
  id         String   @id @default(cuid())
  usuarioId  String?  @map("usuario_id")
  acao       String   @db.VarChar(100)
  entidade   String   @db.VarChar(50)
  entidadeId String?  @map("entidade_id") @db.VarChar(191)
  diff       Json?
  ip         String?  @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  criadoEm   DateTime @default(now()) @map("criado_em")

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([usuarioId, criadoEm])
  @@index([entidade, entidadeId])
  @@index([acao, criadoEm])
  @@map("logs_auditoria")
}

enum TipoSolicitacaoTitular {
  acesso
  correcao
  anonimizacao
  portabilidade
}

enum StatusSolicitacaoTitular {
  aberta
  em_atendimento
  concluida
  recusada
}

/// Pedido de titular de dados (LGPD art. 18). Tela de atendimento vem depois da F0.
model SolicitacaoTitular {
  id            String                   @id @default(cuid())
  tipo          TipoSolicitacaoTitular
  titularTipo   String                   @map("titular_tipo") @db.VarChar(30)
  titularId     String?                  @map("titular_id") @db.VarChar(191)
  titularNome   String                   @map("titular_nome") @db.VarChar(150)
  titularEmail  String                   @map("titular_email") @db.VarChar(191)
  status        StatusSolicitacaoTitular @default(aberta)
  prazoEm       DateTime                 @map("prazo_em")
  atendidoPorId String?                  @map("atendido_por_id")
  observacoes   String?                  @db.Text
  criadoEm      DateTime                 @default(now()) @map("criado_em")
  atualizadoEm  DateTime                 @updatedAt @map("atualizado_em")

  @@map("solicitacoes_titular")
}

// ─── Tarefas ─────────────────────────────────────────────────────────────────
// Ver docs/modulos/tarefas.md. Espaço = departamento; tarefa = demanda.

enum TipoStatus {
  aberto
  em_andamento
  concluido
}

enum PrioridadeTarefa {
  urgente
  alta
  normal
  baixa
}

/// Departamento (ex.: Marketing). Nome único entre os não excluídos (checado no serviço).
model Espaco {
  id           String    @id @default(cuid())
  nome         String    @db.VarChar(80)
  cor          String    @db.Char(7)
  ordem        Decimal   @db.Decimal(20, 10)
  excluidoEm   DateTime? @map("excluido_em")
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")

  membros   MembroEspaco[]
  listas    Lista[]
  etiquetas Etiqueta[]

  @@map("espacos")
}

model MembroEspaco {
  espacoId  String   @map("espaco_id")
  usuarioId String   @map("usuario_id")
  criadoEm  DateTime @default(now()) @map("criado_em")

  espaco  Espaco  @relation(fields: [espacoId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([espacoId, usuarioId])
  @@index([usuarioId])
  @@map("membros_espaco")
}

model Lista {
  id           String    @id @default(cuid())
  espacoId     String    @map("espaco_id")
  nome         String    @db.VarChar(80)
  ordem        Decimal   @db.Decimal(20, 10)
  excluidoEm   DateTime? @map("excluido_em")
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")

  espaco  Espaco        @relation(fields: [espacoId], references: [id])
  status  StatusLista[]
  tarefas Tarefa[]

  @@index([espacoId])
  @@map("listas")
}

model StatusLista {
  id           String     @id @default(cuid())
  listaId      String     @map("lista_id")
  nome         String     @db.VarChar(40)
  cor          String     @db.Char(7)
  tipo         TipoStatus
  ordem        Decimal    @db.Decimal(20, 10)
  criadoEm     DateTime   @default(now()) @map("criado_em")
  atualizadoEm DateTime   @updatedAt @map("atualizado_em")

  lista   Lista    @relation(fields: [listaId], references: [id], onDelete: Cascade)
  tarefas Tarefa[]

  @@index([listaId])
  @@map("status_lista")
}

/// Demanda. Subtarefa tem tarefaPaiId (um nível só) e a mesma lista da tarefa pai.
model Tarefa {
  id           String           @id @default(cuid())
  listaId      String           @map("lista_id")
  tarefaPaiId  String?          @map("tarefa_pai_id")
  titulo       String           @db.VarChar(200)
  descricao    String?          @db.Text
  statusId     String           @map("status_id")
  prioridade   PrioridadeTarefa @default(normal)
  dataInicio   DateTime?        @map("data_inicio") @db.Date
  dataEntrega  DateTime?        @map("data_entrega") @db.Date
  ordem        Decimal          @db.Decimal(20, 10)
  concluidaEm  DateTime?        @map("concluida_em")
  criadoPorId  String           @map("criado_por_id")
  excluidoEm   DateTime?        @map("excluido_em")
  criadoEm     DateTime         @default(now()) @map("criado_em")
  atualizadoEm DateTime         @updatedAt @map("atualizado_em")

  lista        Lista               @relation(fields: [listaId], references: [id])
  tarefaPai    Tarefa?             @relation("Subtarefas", fields: [tarefaPaiId], references: [id])
  subtarefas   Tarefa[]            @relation("Subtarefas")
  status       StatusLista         @relation(fields: [statusId], references: [id])
  criadoPor    Usuario             @relation("TarefasCriadas", fields: [criadoPorId], references: [id])
  responsaveis TarefaResponsavel[]
  checklist    ItemChecklist[]
  etiquetas    TarefaEtiqueta[]
  historico    HistoricoTarefa[]

  @@index([listaId, statusId, ordem])
  @@index([tarefaPaiId])
  @@index([dataEntrega])
  @@index([concluidaEm])
  @@map("tarefas")
}

model TarefaResponsavel {
  tarefaId  String @map("tarefa_id")
  usuarioId String @map("usuario_id")

  tarefa  Tarefa  @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@id([tarefaId, usuarioId])
  @@index([usuarioId])
  @@map("tarefas_responsaveis")
}

model ItemChecklist {
  id        String   @id @default(cuid())
  tarefaId  String   @map("tarefa_id")
  texto     String   @db.VarChar(200)
  concluido Boolean  @default(false)
  ordem     Decimal  @db.Decimal(20, 10)
  criadoEm  DateTime @default(now()) @map("criado_em")

  tarefa Tarefa @relation(fields: [tarefaId], references: [id], onDelete: Cascade)

  @@index([tarefaId, ordem])
  @@map("itens_checklist")
}

model Etiqueta {
  id           String   @id @default(cuid())
  espacoId     String   @map("espaco_id")
  nome         String   @db.VarChar(40)
  cor          String   @db.Char(7)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  espaco  Espaco           @relation(fields: [espacoId], references: [id])
  tarefas TarefaEtiqueta[]

  @@unique([espacoId, nome])
  @@map("etiquetas")
}

model TarefaEtiqueta {
  tarefaId   String @map("tarefa_id")
  etiquetaId String @map("etiqueta_id")

  tarefa   Tarefa   @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  etiqueta Etiqueta @relation(fields: [etiquetaId], references: [id], onDelete: Cascade)

  @@id([tarefaId, etiquetaId])
  @@index([etiquetaId])
  @@map("tarefas_etiquetas")
}

enum CampoHistorico {
  status
  responsaveis
  dataInicio   @map("data_inicio")
  dataEntrega  @map("data_entrega")
  prioridade
  lista
}

/// Somente inserção: cada mudança de status, responsáveis, datas, prioridade ou lista.
model HistoricoTarefa {
  id          String         @id @default(cuid())
  tarefaId    String         @map("tarefa_id")
  usuarioId   String         @map("usuario_id")
  campo       CampoHistorico
  valorAntes  Json?          @map("valor_antes")
  valorDepois Json?          @map("valor_depois")
  criadoEm    DateTime       @default(now()) @map("criado_em")

  tarefa  Tarefa  @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([tarefaId, criadoEm])
  @@index([usuarioId])
  @@map("historico_tarefas")
}

// ─── Conteúdo ────────────────────────────────────────────────────────────────
// Ver docs/modulos/conteudo.md. Marca = conta (IPEMaster, Pedro Prado);
// Canal = plataforma da marca; Publicacao = conteúdo × canal.

enum PlataformaCanal {
  instagram
  youtube
  tiktok
  facebook
  linkedin
  newsletter
  blog
  podcast
  outro
}

enum FormatoConteudo {
  reels
  carrossel
  post
  story
  video
  short
  live
  newsletter
  artigo
  outro
}

enum EtapaConteudo {
  ideia
  planejado
  a_gravar
  gravado
  edicao
  revisao
  aprovado
  publicado
  cancelado
}

enum StatusPublicacao {
  pendente
  publicado
}

model Marca {
  id           String    @id @default(cuid())
  nome         String    @db.VarChar(60)
  cor          String    @db.Char(7)
  ordem        Int
  excluidoEm   DateTime? @map("excluido_em")
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")

  canais    Canal[]
  conteudos Conteudo[]

  @@map("marcas")
}

model Canal {
  id            String          @id @default(cuid())
  marcaId       String          @map("marca_id")
  plataforma    PlataformaCanal
  identificador String?         @db.VarChar(100)
  ordem         Int
  ativo         Boolean         @default(true)
  excluidoEm    DateTime?       @map("excluido_em")
  criadoEm      DateTime        @default(now()) @map("criado_em")
  atualizadoEm  DateTime        @updatedAt @map("atualizado_em")

  marca       Marca        @relation(fields: [marcaId], references: [id])
  publicacoes Publicacao[]

  @@index([marcaId])
  @@map("canais")
}

/// Peça de conteúdo. Passa pelas etapas do pipeline e sai em um ou mais canais (Publicacao).
model Conteudo {
  id             String          @id @default(cuid())
  marcaId        String          @map("marca_id")
  titulo         String          @db.VarChar(200)
  formato        FormatoConteudo
  etapa          EtapaConteudo   @default(ideia)
  roteiro        String?         @db.Text
  legenda        String?         @db.Text
  linkMaterial   String?         @map("link_material") @db.VarChar(500)
  responsavelId  String?         @map("responsavel_id")
  dataGravacao   DateTime?       @map("data_gravacao") @db.Date
  dataPublicacao DateTime?       @map("data_publicacao") @db.Date
  aprovadoPorId  String?         @map("aprovado_por_id")
  aprovadoEm     DateTime?       @map("aprovado_em")
  publicadoEm    DateTime?       @map("publicado_em")
  criadoPorId    String          @map("criado_por_id")
  excluidoEm     DateTime?       @map("excluido_em")
  criadoEm       DateTime        @default(now()) @map("criado_em")
  atualizadoEm   DateTime        @updatedAt @map("atualizado_em")

  marca       Marca        @relation(fields: [marcaId], references: [id])
  responsavel Usuario?     @relation("ConteudoResponsavel", fields: [responsavelId], references: [id])
  criadoPor   Usuario      @relation("ConteudoCriadoPor", fields: [criadoPorId], references: [id])
  aprovadoPor Usuario?     @relation("ConteudoAprovadoPor", fields: [aprovadoPorId], references: [id])
  publicacoes Publicacao[]

  @@index([marcaId, etapa])
  @@index([dataPublicacao])
  @@index([dataGravacao])
  @@map("conteudos")
}

/// Saída de um conteúdo num canal: status, link e métricas (manuais na C1).
model Publicacao {
  id                String           @id @default(cuid())
  conteudoId        String           @map("conteudo_id")
  canalId           String           @map("canal_id")
  status            StatusPublicacao @default(pendente)
  url               String?          @db.VarChar(500)
  publicadoEm       DateTime?        @map("publicado_em")
  alcance           Int?
  visualizacoes     Int?
  curtidas          Int?
  comentarios       Int?
  compartilhamentos Int?
  salvamentos       Int?
  metricasEm        DateTime?        @map("metricas_em")
  criadoEm          DateTime         @default(now()) @map("criado_em")
  atualizadoEm      DateTime         @updatedAt @map("atualizado_em")

  conteudo Conteudo @relation(fields: [conteudoId], references: [id], onDelete: Cascade)
  canal    Canal    @relation(fields: [canalId], references: [id])

  @@unique([conteudoId, canalId])
  @@index([canalId, publicadoEm])
  @@map("publicacoes")
}

// ─── Agenda ──────────────────────────────────────────────────────────────────

/// Tipo de evento institucional (cor e ordem na agenda). Não há exclusão, só desativação.
model TipoEvento {
  id           String   @id @default(cuid())
  nome         String   @unique @db.VarChar(40)
  cor          String   @db.VarChar(7)
  ordem        Int
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  eventos EventoInstitucional[]

  @@map("tipos_evento")
}

/// Evento do calendário institucional. Dias sem fuso; horas "HH:MM" de São Paulo.
model EventoInstitucional {
  id                 String    @id @default(cuid())
  tipoId             String    @map("tipo_id")
  titulo             String    @db.VarChar(150)
  turma              String?   @db.VarChar(100)
  local              String?   @db.VarChar(150)
  descricao          String?   @db.Text
  dataInicio         DateTime  @map("data_inicio") @db.Date
  dataFim            DateTime  @map("data_fim") @db.Date
  horaInicio         String?   @map("hora_inicio") @db.Char(5)
  horaFim            String?   @map("hora_fim") @db.Char(5)
  visivelProfessores Boolean   @default(false) @map("visivel_professores")
  loteId             String?   @map("lote_id")
  criadoPorId        String    @map("criado_por_id")
  excluidoEm         DateTime? @map("excluido_em")
  criadoEm           DateTime  @default(now()) @map("criado_em")
  atualizadoEm       DateTime  @updatedAt @map("atualizado_em")

  tipo      TipoEvento @relation(fields: [tipoId], references: [id])
  criadoPor Usuario    @relation("EventoCriadoPor", fields: [criadoPorId], references: [id])

  @@index([dataInicio, dataFim])
  @@index([loteId])
  @@index([tipoId])
  @@map("eventos_institucionais")
}

/// Agenda pessoal ligada por link iCal (Google/Outlook). Só o dono vê. A URL fica cifrada (ADR 0005).
model AgendaExterna {
  id              String    @id @default(cuid())
  usuarioId       String    @map("usuario_id")
  nome            String    @db.VarChar(60)
  cor             String    @db.VarChar(7)
  urlCifrada      String    @map("url_cifrada") @db.Text
  ultimoSucessoEm DateTime? @map("ultimo_sucesso_em")
  ultimoErro      String?   @map("ultimo_erro") @db.VarChar(200)
  criadoEm        DateTime  @default(now()) @map("criado_em")
  atualizadoEm    DateTime  @updatedAt @map("atualizado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("agendas_externas")
}

/// Link de assinatura .ics do calendário institucional. Guarda só o SHA-256 do token.
model AssinaturaAgenda {
  usuarioId String   @id @map("usuario_id")
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  criadoEm  DateTime @default(now()) @map("criado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("assinaturas_agenda")
}

// ─── Comercial ──────────────────────────────────────────────────────────────

enum TipoProduto {
  curso_livre
  paciente_modelo
  pos_graduacao
}

enum TipoComissao {
  valor
  percentual
}

enum CategoriaLink {
  vendas
  aulas
  outro
}

/// Catálogo único de produtos (cursos, pós e paciente modelo). O Acadêmico usa os mesmos produtos.
model Produto {
  id                     String       @id @default(cuid())
  nome                   String       @db.VarChar(150)
  tipo                   TipoProduto
  area                   String?      @db.VarChar(80)
  /// Único entre não excluídos (checado no serviço).
  sku                    String?      @db.VarChar(60)
  ativo                  Boolean      @default(true)
  duracaoMeses           Int?         @map("duracao_meses")
  recorrente             Boolean      @default(false)
  responsavelPedagogico  String?      @map("responsavel_pedagogico") @db.VarChar(150)
  corpoDocente           String?      @map("corpo_docente") @db.Text
  cargaTeoricaPresencial Int?         @map("carga_teorica_presencial")
  cargaTeoricaSincrona   Int?         @map("carga_teorica_sincrona")
  cargaTeoricaAssincrona Int?         @map("carga_teorica_assincrona")
  cargaPratica           Int?         @map("carga_pratica")
  cargaExtra             Int?         @map("carga_extra")
  comissaoTipo           TipoComissao @default(valor) @map("comissao_tipo")
  comissaoBase           Decimal      @default(0) @map("comissao_base") @db.Decimal(12, 2)
  comissaoBonus          Decimal      @default(0) @map("comissao_bonus") @db.Decimal(12, 2)
  descricao              String?      @db.Text
  ementa                 String?      @db.Text
  observacoes            String?      @db.Text
  excluidoEm             DateTime?    @map("excluido_em")
  criadoEm               DateTime     @default(now()) @map("criado_em")
  atualizadoEm           DateTime     @updatedAt @map("atualizado_em")

  ofertas          OfertaProduto[]
  links            LinkProduto[]
  vendas           Venda[]
  metas            MetaVenda[]
  campanhasAnuncio CampanhaAnuncio[]
  turmas           Turma[]

  @@index([sku])
  @@index([tipo, ativo])
  @@map("produtos")
}

/// Condição de venda de um produto (ex.: "À vista", "Em 24x"). No máximo uma padrão por produto.
model OfertaProduto {
  id                      String   @id @default(cuid())
  produtoId               String   @map("produto_id")
  nome                    String   @db.VarChar(80)
  padrao                  Boolean  @default(false)
  precoCheio              Decimal  @map("preco_cheio") @db.Decimal(12, 2)
  matricula               Decimal  @default(0) @db.Decimal(12, 2)
  /// 0 = à vista.
  parcelas                Int      @default(0)
  valorParcela            Decimal  @default(0) @map("valor_parcela") @db.Decimal(12, 2)
  descontoPontualidadePct Decimal  @default(0) @map("desconto_pontualidade_pct") @db.Decimal(5, 2)
  /// Lista de "pix" | "cartao" | "boleto" | "transferencia".
  formasPagamento         Json     @map("formas_pagamento")
  link                    String?  @db.VarChar(500)
  ordem                   Int
  criadoEm                DateTime @default(now()) @map("criado_em")
  atualizadoEm            DateTime @updatedAt @map("atualizado_em")

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  vendas  Venda[]

  @@index([produtoId])
  @@map("ofertas_produto")
}

model LinkProduto {
  id           String        @id @default(cuid())
  produtoId    String        @map("produto_id")
  titulo       String        @db.VarChar(150)
  url          String        @db.VarChar(500)
  categoria    CategoriaLink @default(outro)
  ordem        Int
  criadoEm     DateTime      @default(now()) @map("criado_em")
  atualizadoEm DateTime      @updatedAt @map("atualizado_em")

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@index([produtoId])
  @@map("links_produto")
}

/// Por onde a venda chegou (Instagram, Indicação...). Lista editável.
model CanalVenda {
  id           String   @id @default(cuid())
  nome         String   @unique @db.VarChar(60)
  ativo        Boolean  @default(true)
  ordem        Int
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  vendas Venda[]

  @@map("canais_venda")
}

enum MetodoPagamento {
  pix
  cartao
  boleto
  transferencia
}

/// Venda registrada pelo vendedor. Guarda nome e WhatsApp do cliente (dado pessoal): criar, editar e excluir geram auditoria.
model Venda {
  id                 String          @id @default(cuid())
  produtoId          String          @map("produto_id")
  ofertaId           String?         @map("oferta_id")
  vendedorId         String          @map("vendedor_id")
  dataVenda          DateTime        @map("data_venda") @db.Date
  dataEntradaLead    DateTime?       @map("data_entrada_lead") @db.Date
  nomeCliente        String          @map("nome_cliente") @db.VarChar(150)
  /// Só dígitos, sem o 55.
  whatsappCliente    String?         @map("whatsapp_cliente") @db.VarChar(20)
  canalId            String?         @map("canal_id")
  dataEntrega        DateTime?       @map("data_entrega") @db.Date
  metodoPagamento    MetodoPagamento @map("metodo_pagamento")
  entrada            Decimal         @default(0) @db.Decimal(12, 2)
  numeroParcelas     Int             @default(0) @map("numero_parcelas")
  valorParcela       Decimal         @default(0) @map("valor_parcela") @db.Decimal(12, 2)
  primeiroVencimento DateTime?       @map("primeiro_vencimento") @db.Date
  /// Sempre recalculado no servidor: entrada + parcelas × valor da parcela.
  valorTotal         Decimal         @map("valor_total") @db.Decimal(12, 2)
  observacoes        String?         @db.Text
  criadoPorId        String          @map("criado_por_id")
  excluidoEm         DateTime?       @map("excluido_em")
  criadoEm           DateTime        @default(now()) @map("criado_em")
  atualizadoEm       DateTime        @updatedAt @map("atualizado_em")

  produto   Produto        @relation(fields: [produtoId], references: [id])
  oferta    OfertaProduto? @relation(fields: [ofertaId], references: [id], onDelete: SetNull)
  vendedor  Usuario        @relation("VendasDoVendedor", fields: [vendedorId], references: [id])
  canal     CanalVenda?    @relation(fields: [canalId], references: [id], onDelete: SetNull)
  criadoPor Usuario        @relation("VendasRegistradas", fields: [criadoPorId], references: [id])

  @@index([dataVenda])
  @@index([vendedorId, dataVenda])
  @@index([produtoId, dataVenda])
  @@map("vendas")
}

/// Meta mensal de um vendedor para um produto. A meta do produto no mês é a soma das metas dos vendedores.
model MetaVenda {
  id             String   @id @default(cuid())
  /// Sempre o dia 1 do mês.
  mes            DateTime @db.Date
  produtoId      String   @map("produto_id")
  vendedorId     String   @map("vendedor_id")
  valorAlvo      Decimal  @default(0) @map("valor_alvo") @db.Decimal(12, 2)
  quantidadeAlvo Int      @default(0) @map("quantidade_alvo")
  criadoEm       DateTime @default(now()) @map("criado_em")
  atualizadoEm   DateTime @updatedAt @map("atualizado_em")

  produto  Produto @relation(fields: [produtoId], references: [id])
  vendedor Usuario @relation("MetasDoVendedor", fields: [vendedorId], references: [id])

  @@unique([mes, produtoId, vendedorId])
  @@index([vendedorId, mes])
  @@map("metas_venda")
}

// ─── Acadêmico ──────────────────────────────────────────────────────────────

enum SituacaoTurma {
  planejada
  em_andamento
  concluida
  cancelada
}

enum SituacaoMatricula {
  ativa
  trancada
  concluida
  cancelada
}

/// Turma de um produto do catálogo. Nome único por produto entre não excluídas (checado no serviço).
model Turma {
  id           String        @id @default(cuid())
  produtoId    String        @map("produto_id")
  nome         String        @db.VarChar(60)
  /// Entrada contínua, sem datas fixas.
  ciclica      Boolean       @default(false)
  dataInicio   DateTime?     @map("data_inicio") @db.Date
  dataFim      DateTime?     @map("data_fim") @db.Date
  situacao     SituacaoTurma @default(planejada)
  observacoes  String?       @db.Text
  excluidoEm   DateTime?     @map("excluido_em")
  criadoEm     DateTime      @default(now()) @map("criado_em")
  atualizadoEm DateTime      @updatedAt @map("atualizado_em")

  produto    Produto     @relation(fields: [produtoId], references: [id])
  matriculas Matricula[]

  @@index([produtoId])
  @@map("turmas")
}

model Aluno {
  id           String   @id @default(cuid())
  nome         String   @db.VarChar(150)
  /// Nome sem acento e em minúsculas, para achar o aluno na importação.
  nomeBusca    String   @map("nome_busca") @db.VarChar(150)
  email        String?  @db.VarChar(150)
  /// Só dígitos.
  telefone     String?  @db.VarChar(20)
  crm          String?  @db.VarChar(20)
  crmUf        String?  @map("crm_uf") @db.Char(2)
  observacoes  String?  @db.Text
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  matriculas Matricula[]

  @@index([nomeBusca])
  @@map("alunos")
}

model Matricula {
  id            String            @id @default(cuid())
  alunoId       String            @map("aluno_id")
  turmaId       String            @map("turma_id")
  situacao      SituacaoMatricula @default(ativa)
  dataInicio    DateTime?         @map("data_inicio") @db.Date
  dataFormatura DateTime?         @map("data_formatura") @db.Date
  vigencia      String?           @db.VarChar(40)
  plano         String?           @db.VarChar(255)
  observacoes   String?           @db.Text
  criadoEm      DateTime          @default(now()) @map("criado_em")
  atualizadoEm  DateTime          @updatedAt @map("atualizado_em")

  aluno Aluno @relation(fields: [alunoId], references: [id])
  turma Turma @relation(fields: [turmaId], references: [id])

  @@unique([alunoId, turmaId])
  @@index([turmaId, situacao])
  @@map("matriculas")
}

model Professor {
  id            String   @id @default(cuid())
  nome          String   @db.VarChar(150)
  email         String?  @db.VarChar(150)
  telefone      String?  @db.VarChar(20)
  crm           String?  @db.VarChar(20)
  crmUf         String?  @map("crm_uf") @db.Char(2)
  especialidade String?  @db.VarChar(120)
  miniCurriculo String?  @map("mini_curriculo") @db.Text
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now()) @map("criado_em")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")

  @@map("professores")
}

// ─── Comercial: Meta Ads ────────────────────────────────────────────────────

enum AtribuicaoCampanha {
  produto
  institucional
  sem_produto
}

enum OrigemImportacao {
  agendada
  manual
}

enum StatusImportacao {
  em_andamento
  concluida
  falhou
}

/// Conta de anúncio da Meta vista pela chave do usuário do sistema.
model ContaAnuncio {
  id           String   @id @default(cuid())
  /// Ex.: "act_123".
  idExterno    String   @unique @map("id_externo") @db.VarChar(40)
  nome         String   @db.VarChar(255)
  moeda        String   @db.VarChar(3)
  /// Contas desligadas não são importadas.
  ativa        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  campanhas CampanhaAnuncio[]

  @@map("contas_anuncio")
}

/// Campanha da Meta e o produto a que ela pertence (atribuição manual).
model CampanhaAnuncio {
  id           String             @id @default(cuid())
  contaId      String             @map("conta_id")
  idExterno    String             @unique @map("id_externo") @db.VarChar(40)
  nome         String             @db.VarChar(255)
  status       String             @db.VarChar(30)
  objetivo     String?            @db.VarChar(60)
  atribuicao   AtribuicaoCampanha @default(sem_produto)
  produtoId    String?            @map("produto_id")
  criadoEm     DateTime           @default(now()) @map("criado_em")
  atualizadoEm DateTime           @updatedAt @map("atualizado_em")

  conta    ContaAnuncio           @relation(fields: [contaId], references: [id])
  produto  Produto?               @relation(fields: [produtoId], references: [id])
  metricas MetricaDiariaAnuncio[]

  @@index([contaId])
  @@index([produtoId])
  @@map("campanhas_anuncio")
}

/// Números de uma campanha num dia (no fuso da conta). Refeitos a cada importação.
model MetricaDiariaAnuncio {
  id                 String   @id @default(cuid())
  campanhaId         String   @map("campanha_id")
  data               DateTime @db.Date
  investimento       Decimal  @default(0) @db.Decimal(12, 2)
  impressoes         Int      @default(0)
  alcance            Int      @default(0)
  cliques            Int      @default(0)
  leadsFormulario    Int      @default(0) @map("leads_formulario")
  leadsSite          Int      @default(0) @map("leads_site")
  conversasIniciadas Int      @default(0) @map("conversas_iniciadas")
  criadoEm           DateTime @default(now()) @map("criado_em")
  atualizadoEm       DateTime @updatedAt @map("atualizado_em")

  campanha CampanhaAnuncio @relation(fields: [campanhaId], references: [id])

  @@unique([campanhaId, data])
  @@index([data])
  @@map("metricas_diarias_anuncio")
}

/// Histórico das importações do Meta Ads. Nunca guarda a chave de acesso.
model ImportacaoAnuncios {
  id            String           @id @default(cuid())
  origem        OrigemImportacao
  status        StatusImportacao @default(em_andamento)
  iniciadoEm    DateTime         @default(now()) @map("iniciado_em")
  finalizadoEm  DateTime?        @map("finalizado_em")
  desde         DateTime?        @db.Date
  ate           DateTime?        @db.Date
  registros     Int              @default(0)
  erro          String?          @db.Text
  iniciadaPorId String?          @map("iniciada_por_id")

  iniciadaPor Usuario? @relation(fields: [iniciadaPorId], references: [id])

  @@index([iniciadoEm])
  @@map("importacoes_anuncios")
}

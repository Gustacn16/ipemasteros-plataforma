// Modelo de dados do IPEMaster OS.
// Convenções: docs/03-modelo-de-dados.md. Toda mudança aqui vira migration
// (`npm run db:migrate -- --name <descricao>`). Nunca editar migration aplicada.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─── Core ────────────────────────────────────────────────────────────────────

enum Papel {
  admin
  gestor
  colaborador
  professor
  aluno
}

/// Usuário com acesso ao sistema. Desativar (ativo = false) em vez de excluir.
/// Campos `email`, `emailVerificado`, `imagem` e as relações são usados pelo Better Auth.
model Usuario {
  id              String    @id @default(cuid())
  nome            String    @db.VarChar(150)
  email           String    @unique @db.VarChar(191)
  emailVerificado Boolean   @default(false) @map("email_verificado")
  imagem          String?   @db.VarChar(500)
  papel           Papel     @default(colaborador)
  ativo           Boolean   @default(true)
  ultimoAcessoEm  DateTime? @map("ultimo_acesso_em")
  criadoEm        DateTime  @default(now()) @map("criado_em")
  atualizadoEm    DateTime  @updatedAt @map("atualizado_em")

  sessoes           Sessao[]
  contas            Conta[]
  convitesEnviados  Convite[]       @relation("ConvitesEnviados")
  logsAuditoria     LogAuditoria[]

  membroDeEspacos   MembroEspaco[]
  tarefasCriadas    Tarefa[]            @relation("TarefasCriadas")
  tarefasAtribuidas TarefaResponsavel[]

  conteudosResponsavel Conteudo[] @relation("ConteudoResponsavel")
  conteudosCriados     Conteudo[] @relation("ConteudoCriadoPor")
  conteudosAprovados   Conteudo[] @relation("ConteudoAprovadoPor")

  @@map("usuarios")
}

/// Sessão de login (gerenciada pelo Better Auth).
model Sessao {
  id           String   @id
  usuarioId    String   @map("usuario_id")
  token        String   @unique @db.VarChar(191)
  expiresAt    DateTime @map("expira_em")
  ipAddress    String?  @map("ip") @db.VarChar(64)
  userAgent    String?  @map("user_agent") @db.VarChar(500)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("sessoes")
}

/// Credencial de login (senha) ou conta externa (gerenciada pelo Better Auth).
model Conta {
  id                    String    @id @default(cuid())
  usuarioId             String    @map("usuario_id")
  accountId             String    @map("conta_id") @db.VarChar(191)
  providerId            String    @map("provedor_id") @db.VarChar(50)
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expira_em")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expira_em")
  scope                 String?   @db.Text
  password              String?   @map("senha_hash") @db.Text
  criadoEm              DateTime  @default(now()) @map("criado_em")
  atualizadoEm          DateTime  @updatedAt @map("atualizado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("contas")
}

/// Tokens de verificação (ex.: redefinição de senha), gerenciados pelo Better Auth.
model Verificacao {
  id           String   @id
  identifier   String   @map("identificador") @db.VarChar(191)
  value        String   @map("valor") @db.Text
  expiresAt    DateTime @map("expira_em")
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([identifier])
  @@map("verificacoes")
}

/// Convite de acesso. Só o hash do token é guardado; o token vai no link do e-mail.
model Convite {
  id             String    @id @default(cuid())
  email          String    @db.VarChar(191)
  nome           String    @db.VarChar(150)
  papel          Papel
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  expiraEm       DateTime  @map("expira_em")
  aceitoEm       DateTime? @map("aceito_em")
  revogadoEm     DateTime? @map("revogado_em")
  convidadoPorId String    @map("convidado_por_id")
  criadoEm       DateTime  @default(now()) @map("criado_em")

  convidadoPor Usuario @relation("ConvitesEnviados", fields: [convidadoPorId], references: [id])

  @@index([email])
  @@map("convites")
}

/// Registro de auditoria. Somente inserção: nunca editar nem apagar pela aplicação.
model LogAuditoria {
  id         String   @id @default(cuid())
  usuarioId  String?  @map("usuario_id")
  acao       String   @db.VarChar(100)
  entidade   String   @db.VarChar(50)
  entidadeId String?  @map("entidade_id") @db.VarChar(191)
  diff       Json?
  ip         String?  @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  criadoEm   DateTime @default(now()) @map("criado_em")

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([usuarioId, criadoEm])
  @@index([entidade, entidadeId])
  @@index([acao, criadoEm])
  @@map("logs_auditoria")
}

enum TipoSolicitacaoTitular {
  acesso
  correcao
  anonimizacao
  portabilidade
}

enum StatusSolicitacaoTitular {
  aberta
  em_atendimento
  concluida
  recusada
}

/// Pedido de titular de dados (LGPD art. 18). Tela de atendimento vem depois da F0.
model SolicitacaoTitular {
  id            String                   @id @default(cuid())
  tipo          TipoSolicitacaoTitular
  titularTipo   String                   @map("titular_tipo") @db.VarChar(30)
  titularId     String?                  @map("titular_id") @db.VarChar(191)
  titularNome   String                   @map("titular_nome") @db.VarChar(150)
  titularEmail  String                   @map("titular_email") @db.VarChar(191)
  status        StatusSolicitacaoTitular @default(aberta)
  prazoEm       DateTime                 @map("prazo_em")
  atendidoPorId String?                  @map("atendido_por_id")
  observacoes   String?                  @db.Text
  criadoEm      DateTime                 @default(now()) @map("criado_em")
  atualizadoEm  DateTime                 @updatedAt @map("atualizado_em")

  @@map("solicitacoes_titular")
}

// ─── Tarefas ─────────────────────────────────────────────────────────────────
// Ver docs/modulos/tarefas.md. Espaço = departamento; tarefa = demanda.

enum TipoStatus {
  aberto
  em_andamento
  concluido
}

enum PrioridadeTarefa {
  urgente
  alta
  normal
  baixa
}

/// Departamento (ex.: Marketing). Nome único entre os não excluídos (checado no serviço).
model Espaco {
  id           String    @id @default(cuid())
  nome         String    @db.VarChar(80)
  cor          String    @db.Char(7)
  ordem        Decimal   @db.Decimal(20, 10)
  excluidoEm   DateTime? @map("excluido_em")
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")

  membros MembroEspaco[]
  listas  Lista[]

  @@map("espacos")
}

model MembroEspaco {
  espacoId  String   @map("espaco_id")
  usuarioId String   @map("usuario_id")
  criadoEm  DateTime @default(now()) @map("criado_em")

  espaco  Espaco  @relation(fields: [espacoId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([espacoId, usuarioId])
  @@index([usuarioId])
  @@map("membros_espaco")
}

model Lista {
  id           String    @id @default(cuid())
  espacoId     String    @map("espaco_id")
  nome         String    @db.VarChar(80)
  ordem        Decimal   @db.Decimal(20, 10)
  excluidoEm   DateTime? @map("excluido_em")
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")

  espaco  Espaco        @relation(fields: [espacoId], references: [id])
  status  StatusLista[]
  tarefas Tarefa[]

  @@index([espacoId])
  @@map("listas")
}

model StatusLista {
  id           String     @id @default(cuid())
  listaId      String     @map("lista_id")
  nome         String     @db.VarChar(40)
  cor          String     @db.Char(7)
  tipo         TipoStatus
  ordem        Decimal    @db.Decimal(20, 10)
  criadoEm     DateTime   @default(now()) @map("criado_em")
  atualizadoEm DateTime   @updatedAt @map("atualizado_em")

  lista   Lista    @relation(fields: [listaId], references: [id], onDelete: Cascade)
  tarefas Tarefa[]

  @@index([listaId])
  @@map("status_lista")
}

/// Demanda. Subtarefa tem tarefaPaiId (um nível só) e a mesma lista da tarefa pai.
model Tarefa {
  id           String           @id @default(cuid())
  listaId      String           @map("lista_id")
  tarefaPaiId  String?          @map("tarefa_pai_id")
  titulo       String           @db.VarChar(200)
  descricao    String?          @db.Text
  statusId     String           @map("status_id")
  prioridade   PrioridadeTarefa @default(normal)
  dataInicio   DateTime?        @map("data_inicio") @db.Date
  dataEntrega  DateTime?        @map("data_entrega") @db.Date
  ordem        Decimal          @db.Decimal(20, 10)
  concluidaEm  DateTime?        @map("concluida_em")
  criadoPorId  String           @map("criado_por_id")
  excluidoEm   DateTime?        @map("excluido_em")
  criadoEm     DateTime         @default(now()) @map("criado_em")
  atualizadoEm DateTime         @updatedAt @map("atualizado_em")

  lista        Lista               @relation(fields: [listaId], references: [id])
  tarefaPai    Tarefa?             @relation("Subtarefas", fields: [tarefaPaiId], references: [id])
  subtarefas   Tarefa[]            @relation("Subtarefas")
  status       StatusLista         @relation(fields: [statusId], references: [id])
  criadoPor    Usuario             @relation("TarefasCriadas", fields: [criadoPorId], references: [id])
  responsaveis TarefaResponsavel[]

  @@index([listaId, statusId, ordem])
  @@index([tarefaPaiId])
  @@index([dataEntrega])
  @@index([concluidaEm])
  @@map("tarefas")
}

model TarefaResponsavel {
  tarefaId  String @map("tarefa_id")
  usuarioId String @map("usuario_id")

  tarefa  Tarefa  @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@id([tarefaId, usuarioId])
  @@index([usuarioId])
  @@map("tarefas_responsaveis")
}

// ─── Conteúdo ────────────────────────────────────────────────────────────────
// Ver docs/modulos/conteudo.md. Marca = conta (IPEMaster, Pedro Prado);
// Canal = plataforma da marca; Publicacao = conteúdo × canal.

enum PlataformaCanal {
  instagram
  youtube
  tiktok
  facebook
  linkedin
  newsletter
  blog
  podcast
  outro
}

enum FormatoConteudo {
  reels
  carrossel
  post
  story
  video
  short
  live
  newsletter
  artigo
  outro
}

enum EtapaConteudo {
  ideia
  planejado
  a_gravar
  gravado
  edicao
  revisao
  aprovado
  publicado
  cancelado
}

enum StatusPublicacao {
  pendente
  publicado
}

model Marca {
  id           String    @id @default(cuid())
  nome         String    @db.VarChar(60)
  cor          String    @db.Char(7)
  ordem        Int
  excluidoEm   DateTime? @map("excluido_em")
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")

  canais    Canal[]
  conteudos Conteudo[]

  @@map("marcas")
}

model Canal {
  id            String          @id @default(cuid())
  marcaId       String          @map("marca_id")
  plataforma    PlataformaCanal
  identificador String?         @db.VarChar(100)
  ordem         Int
  ativo         Boolean         @default(true)
  excluidoEm    DateTime?       @map("excluido_em")
  criadoEm      DateTime        @default(now()) @map("criado_em")
  atualizadoEm  DateTime        @updatedAt @map("atualizado_em")

  marca       Marca        @relation(fields: [marcaId], references: [id])
  publicacoes Publicacao[]

  @@index([marcaId])
  @@map("canais")
}

/// Peça de conteúdo. Passa pelas etapas do pipeline e sai em um ou mais canais (Publicacao).
model Conteudo {
  id             String          @id @default(cuid())
  marcaId        String          @map("marca_id")
  titulo         String          @db.VarChar(200)
  formato        FormatoConteudo
  etapa          EtapaConteudo   @default(ideia)
  roteiro        String?         @db.Text
  legenda        String?         @db.Text
  linkMaterial   String?         @map("link_material") @db.VarChar(500)
  responsavelId  String?         @map("responsavel_id")
  dataGravacao   DateTime?       @map("data_gravacao") @db.Date
  dataPublicacao DateTime?       @map("data_publicacao") @db.Date
  aprovadoPorId  String?         @map("aprovado_por_id")
  aprovadoEm     DateTime?       @map("aprovado_em")
  publicadoEm    DateTime?       @map("publicado_em")
  criadoPorId    String          @map("criado_por_id")
  excluidoEm     DateTime?       @map("excluido_em")
  criadoEm       DateTime        @default(now()) @map("criado_em")
  atualizadoEm   DateTime        @updatedAt @map("atualizado_em")

  marca       Marca        @relation(fields: [marcaId], references: [id])
  responsavel Usuario?     @relation("ConteudoResponsavel", fields: [responsavelId], references: [id])
  criadoPor   Usuario      @relation("ConteudoCriadoPor", fields: [criadoPorId], references: [id])
  aprovadoPor Usuario?     @relation("ConteudoAprovadoPor", fields: [aprovadoPorId], references: [id])
  publicacoes Publicacao[]

  @@index([marcaId, etapa])
  @@index([dataPublicacao])
  @@index([dataGravacao])
  @@map("conteudos")
}

/// Saída de um conteúdo num canal: status, link e métricas (manuais na C1).
model Publicacao {
  id                String           @id @default(cuid())
  conteudoId        String           @map("conteudo_id")
  canalId           String           @map("canal_id")
  status            StatusPublicacao @default(pendente)
  url               String?          @db.VarChar(500)
  publicadoEm       DateTime?        @map("publicado_em")
  alcance           Int?
  visualizacoes     Int?
  curtidas          Int?
  comentarios       Int?
  compartilhamentos Int?
  salvamentos       Int?
  metricasEm        DateTime?        @map("metricas_em")
  criadoEm          DateTime         @default(now()) @map("criado_em")
  atualizadoEm      DateTime         @updatedAt @map("atualizado_em")

  conteudo Conteudo @relation(fields: [conteudoId], references: [id], onDelete: Cascade)
  canal    Canal    @relation(fields: [canalId], references: [id])

  @@unique([conteudoId, canalId])
  @@index([canalId, publicadoEm])
  @@map("publicacoes")
}
